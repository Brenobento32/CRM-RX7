# Copie para `.env` e preencha com os dados do MESMO projeto Supabase do CRM
# (Project Settings -> API). `.env` está no .gitignore.
#
# SUPABASE_SERVICE_ROLE_KEY ignora completamente a RLS — é por isso que ela
# só existe aqui, num processo separado do Next.js, e nunca no .env do CRM.

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
