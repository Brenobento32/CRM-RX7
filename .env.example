# ---------------------------------------------------------------------------
# Scorpion CRM — variáveis de ambiente
#
# Copie este arquivo para `.env.local` e preencha com os valores do seu
# projeto no Supabase (Project Settings -> API).
# `.env.local` está no .gitignore e nunca deve ser commitado.
# ---------------------------------------------------------------------------

# URL do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon / publishable). Pode ficar visível no browser: ela não dá
# acesso a nada além do que as policies de RLS permitirem ao usuário logado.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# URL base da aplicação. Usada em redirects de autenticação e em links de
# e-mail. Em produção, aponte para o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NÃO adicione a SUPABASE_SERVICE_ROLE_KEY aqui sem necessidade real.
#
# Essa chave ignora completamente a RLS. Se ela entrar no caminho de um
# request, a regra "closer vê apenas seus clientes" deixa de existir — e a
# falha é silenciosa. Ela só deve aparecer se um dia houver um job
# administrativo isolado, e nunca em código importado por página ou action.
# ---------------------------------------------------------------------------
