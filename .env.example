# ---------------------------------------------------------------------------
# AVANTE (CRM-RX7 SaaS) — variáveis de ambiente do app Next.js
#
# Local: copie para `.env.local` (está no .gitignore; nunca commitar).
# Hostinger (Node.js Web App): cadastre as MESMAS três variáveis no painel do
# app. As três são NEXT_PUBLIC_*: o Next.js grava o valor no build, então
# precisam existir no BUILD e no RUNTIME (a Hostinger injeta nos dois).
# Mudou alguma? Faça um novo build.
# ---------------------------------------------------------------------------

# URL do projeto Supabase do CRM-RX7 (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon / publishable). Pode ficar visível no browser: ela não dá
# acesso a nada além do que as policies de RLS permitirem ao usuário logado.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# URL pública do app, sem barra no fim. Usada nos links de e-mail (recuperar
# senha) e precisa estar nas Redirect URLs do Supabase Auth.
# Local: http://localhost:3000 — Produção (AVANTE): https://avante.riox7comunicacao.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NUNCA coloque a SUPABASE_SERVICE_ROLE_KEY no app (nem aqui, nem na Hostinger).
#
# Essa chave ignora completamente a RLS e o isolamento entre empresas. Ela só
# existe nas Edge Functions (injetada pelo Supabase) e no whatsapp-service,
# que é um processo separado e não roda na Hostinger.
# ---------------------------------------------------------------------------
